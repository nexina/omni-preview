[Desktop Entry]
Name=Omni Preview
Comment=All-in-one file previewer and document viewer application
Exec=omni_preview %U
Icon=nexina.omni.preview
Type=Application
Terminal=false
Categories=Utility;Viewer;
MimeType=application/pdf;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.openxmlformats-officedocument.presentationml.presentation;image/jpeg;image/png;image/gif;image/bmp;image/svg+xml;image/webp;text/plain;text/markdown;application/json;application/xml;text/html;text/css;text/javascript;application/x-typescript;text/x-python;application/zip;audio/mpeg;video/mp4;video/x-matroska;video/x-msvideo;
StartupWMClass=omni_preview
